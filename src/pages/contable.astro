---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '@fontsource/libre-baskerville/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import { accountingServices } from '../data/accounting';
import { indexable, site } from '../data/site';

const title = 'Servicios contables en Puebla | Iuris Balance';
const description = 'Contabilidad general, nómina, conciliaciones y reportes financieros para personas, profesionistas y empresas en Puebla.';
const canonical = site.siteUrl ? new URL('/contable', site.siteUrl).href : undefined;
const logo = '/brand/iuris-balance-verde-dorado.svg';
const telephone = 'tel:' + site.contact.phoneE164;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header>
      <div class="header-inner">
        <a href="/" aria-label="Iuris Balance, inicio"><img src={logo} alt="Iuris Balance" width="250" height="60" /></a>
        <nav class="accounting-nav" aria-label="Área contable"><a href="#servicios-contables">Servicios</a><a href="#forma-de-trabajo">Cómo trabajamos</a><a href="#contacto-contable">Contacto</a><a href="/">Área jurídica ↗</a></nav>
      </div>
    </header>
    <main id="contenido">
      <section class="accounting-hero">
        <div class="wrap split">
          <div>
            
            <h1>Servicios contables<br />en Puebla</h1><p class="lead">Organiza tus registros y entiende la situación financiera de tu negocio.</p><a class="button light" href="#servicios-contables">Explorar servicios ↓</a>
          </div>
          <div class="accounting-hero-note"><img src="/images/accounting-workspace.webp" alt="" width="1000" height="667" fetchpriority="high" /><p class="eyebrow">Modalidades de atención</p><h2>Mensual o por proyecto</h2><p>Para personas físicas, profesionistas, emprendedores y empresas. Definimos el alcance según tu operación y la información que necesitas.</p><a href="#contacto-contable">Consultar disponibilidad ↗</a></div>
        </div>
      </section>
      <section id="servicios-contables" class="wrap">
        <p class="eyebrow">Servicios contables</p><h2>De los registros a la toma de decisiones</h2>
        <dl class="accounting-services">
          {accountingServices.map(({ title, details }) => (
            <div>
              <dt>{title}</dt>
              <dd>{details}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section id="forma-de-trabajo" class="ivory">
        <div class="wrap">
          <p class="eyebrow">Cómo trabajamos</p>
          <h2>De la primera conversación al seguimiento</h2>
          <div class="accounting-process"><img src="/images/accounting-reports.webp" alt="" width="900" height="516" loading="lazy" decoding="async" /><ol class="accounting-steps">
            <li><h3>Diagnóstico</h3><p>Revisamos cómo opera tu negocio, qué información tienes y qué necesitas resolver.</p></li>
            <li><h3>Propuesta</h3><p>Acordamos el alcance, los entregables, los plazos y los honorarios.</p></li>
            <li><h3>Ejecución y seguimiento</h3><p>Reunimos la documentación, realizamos el trabajo acordado y comunicamos los avances.</p></li>
          </ol></div>
        </div>
      </section>
      <section id="contacto-contable" class="accounting-contact">
        <div class="wrap split">
          <div>
            <h2>Cuéntanos qué necesitas</h2>
            <p>El alcance se define según el volumen de operaciones, el estado de tus registros y los entregables que necesites.</p>
            <a class="button" href={telephone}>Llamar al despacho</a>

          </div>
          <div>
            <p><strong>{site.brand.name}</strong><br />{site.contact.address}<br />{site.contact.businessHours}</p>
            <a class="text-link" href={site.contact.mapUrl}>Ver ubicación en el mapa ↗</a>
            <p><a href={telephone}>{site.contact.phoneDisplay}</a><br /><a href={'tel:' + site.contact.secondPhoneE164}>{site.contact.secondPhoneDisplay}</a></p>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <p><strong>{site.brand.name}</strong><br />{site.brand.descriptor}</p>
      <a href="/">Volver al área jurídica</a>
    </footer>
<WhatsAppButton />
  </body>
</html>

<style>
  .accounting-hero {
    background: var(--color-brand-green);
    color: var(--color-ivory);
    border-radius: 0 48px 0 0;
  }
  .accounting-hero .split {
    align-items: center;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    min-height: 510px;
  }
  .accounting-hero-note {
    border: 1px solid #79907e;
    border-radius: 28px;
    padding: clamp(24px, 4vw, 48px);
    background: #ffffff0a;
  }
  .accounting-hero-note img, .accounting-process img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 18px;
  }
  .accounting-hero-note img { aspect-ratio: 16/9; margin-bottom: 24px; }
  .accounting-process {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }
  .accounting-process .accounting-steps {
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 0;
  }
  @media (max-width: 767px) {
    .accounting-process { grid-template-columns: 1fr; }
  }
  .accounting-hero-note h2 { font-size: clamp(26px, 3vw, 38px); }
  .accounting-hero-note a { display: inline-flex; align-items: center; min-height: 44px; }
  .accounting-hero .lead { margin: 24px 0 32px; max-width: 36ch; }
  .accounting-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 40px 0 0;
    padding-left: 24px;
  }
  .accounting-steps li { border-top: 1px solid var(--color-brand-gold); padding: 20px 12px 0 0; }
  .accounting-steps li::marker { color: var(--color-gold-text); font-weight: 600; }
  .accounting-contact { background: #edf3ed; }
  .accounting-nav { flex-wrap: wrap; }
  .accounting-hero .eyebrow { color: #d5bc80; }
  .accounting-hero h1 { font-size: clamp(34px, 4.5vw, 64px); margin-bottom: 0; }
  .accounting-hero :focus-visible { outline-color: white; }
  .accounting-services > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 32px;
    border-top: 1px solid var(--color-border);
    padding-block: 24px;
  }
  .accounting-services dt { font: 700 22px/1.4 var(--font-heading); }
  .accounting-services dd { margin: 0; }
  #contacto-contable p { max-width: 55ch; }
  .header-inner > a:last-child { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 767px) {
    .accounting-services > div { grid-template-columns: 1fr; gap: 8px; }
    .accounting-hero .split, .accounting-steps { grid-template-columns: 1fr; }
    .accounting-hero .split { min-height: 0; }
    .header-inner { gap: 8px; }
    .accounting-nav { display: flex; flex-direction: row; column-gap: 16px; }
  }
</style>
